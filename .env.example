# The variables the game server reads. Nothing loads this file by itself: set them in your shell
# (for example `APP_ENV=development PORT=2567 pnpm dev`) or pass it with `node --env-file=.env`.
# On Railway, .railway/railway.ts sets APP_ENV, PORT and LOG_LEVEL for each environment.
# None of these is a secret. Real secrets live in Railway variables (sealed), never in the repository.

# Port the server listens on. Railway uses 8080.
PORT=2567

# local | development | production. Everything except production turns on debug commands,
# the state inspector and the Colyseus monitor at /colyseus.
APP_ENV=development

# Log level of the server (pino): trace, debug, info, warn, error.
LOG_LEVEL=info

# Byte budget of the in-memory replay and bug-report stores, in megabytes. Lost on every deploy.
MEMORY_BUDGET_MB=256

# The commit /health reports. Railway sets RAILWAY_GIT_COMMIT_SHA itself; set this only elsewhere.
# GIT_SHA=

# Client development only: where the game server is (default http://localhost:2567).
# VITE_SERVER_URL=

# The gateway (server/gateway) only. On Railway .railway/railway.ts sets these.
# GAMES=team-2,team-4              the games it serves, each at /<game>/
# PLANNED_GAMES=team-1,team-3      listed on its index page as "not released yet"
# UPSTREAM_PORT=8080               port of the game services on Railway's private network
# UPSTREAMS=team-2=http://127.0.0.1:2601,team-4=http://127.0.0.1:2602   local run: where each game is
