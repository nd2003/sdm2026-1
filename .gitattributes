# Keep LF line endings in the repo and in every checkout, on every OS.
# Without this, Windows checkouts get CRLF and Biome flags every file.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.woff binary
*.woff2 binary
*.glb binary
