{
  "name": "sdm2026",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "preinstall": "node server/tooling/check-node.mjs",
    "new-game": "node server/tooling/new-game.mjs",
    "dev": "pnpm --filter @sdm/template dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p .railway",
    "gen:api": "tsx server/core/src/scripts/gen-api-schema.ts",
    "check:setup": "node server/tooling/check-setup.mjs",
    "workflow:classify": "node server/tooling/workflow/classify.mjs",
    "check:issue": "node server/tooling/workflow/check-issue.mjs",
    "check:pr": "node server/tooling/workflow/check-pr.mjs",
    "check:commit": "node server/tooling/workflow/check-commit.mjs",
    "labels:sync": "node server/tooling/workflow/labels-sync.mjs",
    "labels:prs": "node server/tooling/workflow/pr-labels.mjs",
    "check:branch": "node server/tooling/workflow/check-branch.mjs",
    "check:ownership": "node server/tooling/workflow/check-ownership.mjs",
    "check:files": "node server/tooling/workflow/check-files.mjs",
    "check:secrets": "node server/tooling/workflow/check-files.mjs secrets",
    "check:docs": "node server/tooling/workflow/check-docs.mjs",
    "check:config": "node server/tooling/workflow/check-config.mjs",
    "check:determinism": "node server/tooling/workflow/check-determinism.mjs",
    "check:contract": "node server/tooling/workflow/check-contract.mjs",
    "preflight": "node server/tooling/workflow/preflight.mjs",
    "preflight:quick": "node server/tooling/workflow/preflight.mjs --quick",
    "qa:bots": "node scripts/qa/bots.mjs",
    "qa:multi": "node scripts/qa/multi.mjs",
    "qa:load": "pnpm dlx @colyseus/loadtest@0.18.4 scripts/qa/load.ts --endpoint ws://localhost:2567 --room sample_room --numClients 50",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "22.20.5",
    "colyseus.js": "^0.16.22",
    "playwright": "^1.65.0",
    "railway": "3.16.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
