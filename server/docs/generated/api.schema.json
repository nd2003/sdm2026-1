    "POST /api/bug-reports": {
      "summary": "F8 bug report; the server keeps a copy of the room's replay",
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
