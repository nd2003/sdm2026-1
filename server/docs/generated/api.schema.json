            "type": "string"
          },
          "env": {
            "type": "string",
            "enum": [
              "local",
              "development",
              "staging",
              "production"
            ]
          },
          "sha": {
            "type": "string"
          },
          "roomId": {
            "type": [
              "string",
              "null"
            ]
          },
          "playerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "tick": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "scenario": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "userAgent": {
            "type": "string"
          },
          "net": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "latencyMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "jitterMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "lossPct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "latencyMs",
                  "jitterMs",
                  "lossPct"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "logs": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshot": {
            "anyOf": [
              {
                "type": "string",
                "format": "starts_with",
                "pattern": "^data:image\\/.*"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "game",
          "env",
