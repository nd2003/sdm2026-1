            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "url"
          ],
          "additionalProperties": false
        },
        "400": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        },
        "413": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
