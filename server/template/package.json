{
  "name": "@sdm/template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reference game. Copy this folder to games/team-N/ to start a team's game.",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch --clear-screen=false server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.45",
    "@colyseus/sdk": "0.18.9",
    "@sdm/core": "workspace:*",
    "@sdm/host": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sdm/tooling": "workspace:*",
    "vite": "8.3.6"
  }
}
