{
  "$comment": "Single source of truth for the workflow tooling: the change types, their templates and commit types. Read by classify.mjs and the check:* scripts.",
  "teamLabels": ["team-1", "team-2", "team-3", "team-4", "platform", "team-instructor"],
  "types": {
    "feature": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/feature.md",
      "prTemplate": ".github/PULL_REQUEST_TEMPLATE/feature.md",
      "commitTypes": ["feat"],
      "githubLabel": "enhancement"
    },
    "bug": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/bug.md",
      "prTemplate": ".github/PULL_REQUEST_TEMPLATE/bug.md",
      "commitTypes": ["fix"],
      "githubLabel": "bug"
    },
    "docs": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/docs.md",
      "prTemplate": ".github/PULL_REQUEST_TEMPLATE/docs.md",
      "commitTypes": ["docs"],
      "githubLabel": "documentation"
    },
    "chore": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/chore.md",
      "prTemplate": ".github/PULL_REQUEST_TEMPLATE/chore.md",
      "commitTypes": ["chore", "ci", "build", "test", "perf"],
      "githubLabel": null
    },
    "refactor": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/refactor.md",
      "prTemplate": ".github/PULL_REQUEST_TEMPLATE/refactor.md",
      "commitTypes": ["refactor"],
      "githubLabel": null
    },
    "release": {
      "issueTemplate": null,
      "prTemplate": ".github/PULL_REQUEST_TEMPLATE/release.md",
      "commitTypes": [],
      "githubLabel": null
    },
    "sync": {
      "issueTemplate": null,
      "prTemplate": ".github/PULL_REQUEST_TEMPLATE/sync.md",
      "commitTypes": [],
      "githubLabel": null
    }
  },
  "commitPrefixToType": {
    "feat": "feature",
    "fix": "bug",
    "docs": "docs",
    "refactor": "refactor",
    "chore": "chore",
    "ci": "chore",
    "build": "chore",
    "test": "chore",
    "perf": "chore"
  },
  "docsPaths": ["course/**", "**/*.md", "docs/**"],
  "choreRules": [
    {
      "commitType": "ci",
      "paths": [".github/**"]
    },
    {
      "commitType": "build",
      "paths": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
    },
    {
      "commitType": "chore",
      "paths": [
        ".claude/**",
        ".vscode/**",
        ".editorconfig",
        ".gitattributes",
        ".gitignore",
        ".nvmrc",
        ".env.example",
        "biome.json",
        "vitest.config.ts",
        "server/tooling/**"
      ]
    }
  ],
  "testPaths": ["**/*.test.ts", "**/*.test.mjs", "e2e/**"],
  "codePaths": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.css", "**/*.html"]
}
